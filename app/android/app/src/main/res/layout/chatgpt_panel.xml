<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chatgpt_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/chatgpt_sheet_background">

    <FrameLayout
        android:id="@+id/chatgpt_drag_handle"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="上拉展开，下拉收起 ChatGPT">

        <TextView
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/chatgpt_handle" />

        <TextView
            android:id="@+id/chatgpt_mode"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingHorizontal="10dp"
            android:background="@drawable/chatgpt_mode_background"
            android:text="1/3"
            android:textColor="#b8a4ff"
            android:textSize="13sp" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/chatgpt_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/chatgpt_web"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/chatgpt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:padding="12dp"
            android:background="#ef151622"
            android:textColor="#ffc6ca"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
